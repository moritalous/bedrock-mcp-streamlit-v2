{
    "mcpServers": {
        "novacanvas": {
            "command": "uvx",
            "args": [
                "awslabs.nova-canvas-mcp-server@latest"
            ],
            "env": {
                "AWS_PROFILE": "default",
                "AWS_REGION": "us-east-1",
                "FASTMCP_LOG_LEVEL": "ERROR"
            }
        },
        "costanalysis": {
            "command": "uvx",
            "args": [
                "awslabs.cost-analysis-mcp-server@latest"
            ],
            "env": {
                "FASTMCP_LOG_LEVEL": "ERROR",
                "AWS_PROFILE": "default"
            }
        },
        "awsdocumentation": {
            "command": "uvx",
            "args": [
                "awslabs.aws-documentation-mcp-server@latest"
            ],
            "env": {
                "FASTMCP_LOG_LEVEL": "ERROR"
            }
        },
        "cdk": {
            "command": "uvx",
            "args": [
                "awslabs.cdk-mcp-server@latest"
            ],
            "env": {
                "FASTMCP_LOG_LEVEL": "ERROR"
            }
        }
    }
}